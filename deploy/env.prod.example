# Production settings for docker-compose.prod.yml. On the server this lives at
# /opt/docagent/.env with mode 600 and is never committed. deploy/README.md shows how to
# generate the secrets. Hostnames are the compose service names (internal network).

API_DOMAIN=api.meetmoeed.com

# --- Database (owner + the two roles the migrations create) ---
POSTGRES_USER=docagent
POSTGRES_PASSWORD=<random>
POSTGRES_DB=docagent
DATABASE_URL=postgresql://docagent:<POSTGRES_PASSWORD>@postgres:5432/docagent
DATABASE_APP_URL=postgresql://docagent_app:<random>@postgres:5432/docagent
DATABASE_READER_URL=postgresql://docagent_reader:<random>@postgres:5432/docagent

# --- LLM (used only through packages/gateway) ---
GEMINI_API_KEY=<from your Google AI Studio key>

# --- MCP servers (internal network only; URLs are set in docker-compose.prod.yml) ---
MCP_SHARED_SECRET=<random, >= 16 chars>

# --- Spend caps ---
DAILY_BUDGET_USD=3.00
SESSION_BUDGET_USD=0.10
EVAL_BUDGET_USD=3.00

# --- API ---
ALLOWED_ORIGINS=https://demo.meetmoeed.com
COOKIE_SECURE=true
COOKIE_DOMAIN=.meetmoeed.com
IP_HASH_SALT=<random>
REPLAY_ONLY=false
REPLAY_SPEED=1.0
