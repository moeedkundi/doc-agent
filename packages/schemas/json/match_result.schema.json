{
  "$defs": {
    "LineMatch": {
      "additionalProperties": false,
      "description": "How one invoice line was paired with a PO line (drives the UI's side-by-side diff).",
      "properties": {
        "invoice_line": {
          "title": "Invoice Line",
          "type": "integer"
        },
        "method": {
          "enum": [
            "sku",
            "description"
          ],
          "title": "Method",
          "type": "string"
        },
        "po_line": {
          "title": "Po Line",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "invoice_line",
        "po_line",
        "method",
        "score"
      ],
      "title": "LineMatch",
      "type": "object"
    },
    "MatchIssue": {
      "additionalProperties": false,
      "properties": {
        "invoice_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invoice Line"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "po_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Po Line"
        },
        "rule": {
          "enum": [
            "vendor_mismatch",
            "currency_mismatch",
            "line_not_on_po",
            "qty_exceeds_remaining",
            "unit_price_out_of_tolerance",
            "total_exceeds_remaining",
            "po_not_found"
          ],
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "message"
      ],
      "title": "MatchIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "issues": {
      "items": {
        "$ref": "#/$defs/MatchIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "line_matches": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LineMatch"
      },
      "title": "Line Matches",
      "type": "array"
    },
    "status": {
      "enum": [
        "matched",
        "partial",
        "mismatch",
        "po_not_found"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "issues"
  ],
  "title": "MatchResult",
  "type": "object"
}
