# Copy to .env and fill in. Never commit real keys.

# --- Database ---
# docker compose publishes Postgres on host port POSTGRES_HOST_PORT (default 5433,
# so it doesn't clash with a locally installed Postgres on 5432).
POSTGRES_HOST_PORT=5433
POSTGRES_USER=docagent
POSTGRES_PASSWORD=docagent
POSTGRES_DB=docagent
DATABASE_URL=postgresql://docagent:docagent@127.0.0.1:5433/docagent
DATABASE_APP_URL=postgresql://docagent_app:change-me@127.0.0.1:5433/docagent
DATABASE_READER_URL=postgresql://docagent_reader:change-me@127.0.0.1:5433/docagent

# --- LLM providers (used only by packages/gateway) ---
GEMINI_API_KEY=                  # both tiers are Gemini (config/models.yaml); the strong
                                 # tier needs a paid-tier key (free-tier quota is 0)

# --- MCP servers (internal network only) ---
MCP_SHARED_SECRET=
MCP_EXTRACTION_URL=http://extraction:8101/mcp
MCP_VALIDATION_URL=http://validation:8102/mcp
MCP_SQLSTORE_URL=http://sqlstore:8103/mcp
MCP_REFERENCE_URL=http://reference:8104/mcp

# --- Spend caps ---
DAILY_BUDGET_USD=3.00
SESSION_BUDGET_USD=0.25

# --- API ---
UPLOAD_DIR=/data/uploads
TURNSTILE_SECRET=                # optional
ALLOWED_ORIGINS=https://demo.meetmoeed.com,http://localhost:3000
